{
  "name": "obsidian-code-palette",
  "version": "0.2.1",
  "private": true,
  "description": "Obsidian 文件与文件夹代码语言规则和独立代码配色",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@lezer/markdown": "^1.8.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
